# Copy to .env and fill in.  Real environment variables override this file.
#
#   cp .env.example .env
#   chmod 600 .env                                            # Linux / macOS
#   icacls .env /inheritance:r /grant:r "%USERDOMAIN%\%USERNAME%:F"   # Windows
#
# .env is gitignored. Do not paste it into a ticket, a transcript, or a chat
# window - it holds a password that can read every secret in scope.
#
# A .env file is one of three ways to configure this; see the README. It sets
# environment variables, which sit between command-line arguments (highest)
# and the config file (lowest).

# Scheme + host + the /SecretServer virtual directory. The vdir is required:
# https://host/SecretServer/oauth2/token is the token endpoint, and dropping
# /SecretServer gives a 404 that looks exactly like "Enable Webservices is off".
SS_BASE_URL=https://secretserver.example.com/SecretServer

# Use an APPLICATION ACCOUNT, not a human admin login. Per the API spec:
# "Application accounts are used for automation, cannot log in using the UI,
# and do not consume a user license." Because they cannot use the UI, 2FA is
# not in play - and 2FA breaks the OAuth password grant with an HTTP 400 that
# reads exactly like a wrong password.
# Create: Admin -> Users -> Create New, tick "Application Account", then grant
# it View on BOTH the folders and their secrets - two separate grants.
SS_USERNAME=svc_enzoic_api
SS_PASSWORD=

# Only for a domain login; the username may instead be EXAMPLE\svc_enzoic_api
# SS_DOMAIN=example.com

# The RAW 32-hex key from https://console.enzoic.com - not base64, not
# key:secret. Leave it blank to list and read the secrets without checking
# them, which is a useful first run: it proves the Secret Server half works.
ENZOIC_API_KEY=
